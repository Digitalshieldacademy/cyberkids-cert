  line-height: 0.95;
  letter-spacing: 2px;
  text-shadow: 0 0 40px rgba(58, 169, 255, 0.4);
}
.t-blue {
  background: linear-gradient(180deg, #7fd3ff 0%, #3aa9ff 50%, #0d4d8c 100%);
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent;
  filter: drop-shadow(0 4px 0 rgba(0,0,0,0.4));
}
.t-yellow {
  background: linear-gradient(180deg, #ffe580 0%, #ffd84d 50%, #b8860b 100%);
