   CYBER KIDS · Digital Shield Academy
   Diseño cyberpunk para certificado personalizado
   ========================================================= */

* { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg-deep:     #050816;
  --bg-card:     #0d1430;
  --bg-card-2:   #131c44;
  --blue:        #3aa9ff;
  --blue-light:  #7fd3ff;
  --blue-dark:   #0d4d8c;
  --gold:        #d4af37;
  --gold-light:  #f4d57a;
  --yellow:      #ffd84d;
  --red:         #ff4d4d;
  --purple:      #6d4ad6;
  --text:        #e8efff;
  --text-dim:    #9aa8d4;
  --border:      rgba(127, 211, 255, 0.18);
  --shadow-glow: 0 0 40px rgba(58, 169, 255, 0.18);
}

html { scroll-behavior: smooth; }

body {
  font-family: 'Rajdhani', system-ui, sans-serif;
  background: var(--bg-deep);
  color: var(--text);
  min-height: 100vh;
  overflow-x: hidden;
  position: relative;
  line-height: 1.5;
}

/* Fondo animado tipo circuito */
.bg-grid {
  position: fixed; inset: 0; z-index: -2; pointer-events: none;
  background-image:
    linear-gradient(rgba(58, 169, 255, 0.06) 1px, transparent 1px),
    linear-gradient(90deg, rgba(58, 169, 255, 0.06) 1px, transparent 1px);
  background-size: 48px 48px;
  mask-image: radial-gradient(ellipse at 50% 30%, #000 0%, transparent 75%);
}
.bg-glow {
  position: fixed; inset: 0; z-index: -1; pointer-events: none;
  background:
    radial-gradient(circle at 20% 0%, rgba(58, 169, 255, 0.18), transparent 45%),
    radial-gradient(circle at 80% 20%, rgba(109, 74, 214, 0.16), transparent 45%),
    radial-gradient(circle at 50% 100%, rgba(255, 216, 77, 0.06), transparent 50%);
}

.visually-hidden {
  position: absolute !important;
  width: 1px; height: 1px;
  padding: 0; margin: -1px;
  overflow: hidden; clip: rect(0,0,0,0);
  white-space: nowrap; border: 0;
}

/* ============== HEADER ============== */
.site-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18px 24px;
  max-width: 1100px;
  margin: 0 auto;
  flex-wrap: wrap;
  gap: 12px;
}
.brand { display: flex; align-items: center; gap: 12px; }
.brand-shield {
  width: 44px; height: 44px;
  display: grid; place-items: center;
  background: linear-gradient(145deg, #0d4d8c, #051838);
  border-radius: 8px;
  border: 1px solid var(--border);
  box-shadow: var(--shadow-glow);
}
.brand-text { display: flex; flex-direction: column; line-height: 1; }
.brand-title {
  font-family: 'Orbitron', sans-serif;
  font-weight: 900;
  letter-spacing: 1px;
  font-size: 18px;
}
.brand-sub {
  font-family: 'Orbitron', sans-serif;
  font-size: 10px;
  letter-spacing: 6px;
  color: var(--blue-light);
  margin-top: 3px;
}
.privacy-pill {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 8px 14px;
  background: rgba(20, 220, 130, 0.08);
  border: 1px solid rgba(20, 220, 130, 0.4);
  border-radius: 999px;
  font-size: 12px;
  font-weight: 700;
  color: #4ee79a;
  letter-spacing: 1px;
}
.pulse-dot {
  width: 8px; height: 8px;
  background: #4ee79a; border-radius: 50%;
  box-shadow: 0 0 0 0 rgba(78, 231, 154, 0.7);
  animation: pulse 1.8s infinite;
}
@keyframes pulse {
  0%   { box-shadow: 0 0 0 0 rgba(78, 231, 154, 0.7); }
  70%  { box-shadow: 0 0 0 12px rgba(78, 231, 154, 0); }
  100% { box-shadow: 0 0 0 0 rgba(78, 231, 154, 0); }
}

/* ============== HERO ============== */
.hero {
  text-align: center;
  padding: 36px 20px 18px;
  max-width: 1100px;
  margin: 0 auto;
}
.hero-tagline {
  font-family: 'Orbitron', sans-serif;
  font-size: 12px;
  letter-spacing: 6px;
  color: var(--blue-light);
  margin-bottom: 14px;
}
.hero-title {
  font-family: 'Orbitron', sans-serif;
  font-weight: 900;
