/* =========================================================
   CYBER KIDS · Digital Shield Academy
   Diseño Cyberpunk Premium
========================================================= */

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

:root{

  --bg-deep:#050816;
  --bg-card:#0d1430;
  --bg-card-2:#131c44;

  --blue:#3aa9ff;
  --blue-light:#7fd3ff;
  --blue-dark:#0d4d8c;

  --gold:#d4af37;
  --gold-light:#f4d57a;

  --yellow:#ffd84d;
  --purple:#6d4ad6;
  --red:#ff4d4d;

  --text:#e8efff;
  --text-dim:#9aa8d4;

  --border:rgba(127,211,255,.18);

  --shadow-glow:
    0 0 40px rgba(58,169,255,.15);

}

html{
  scroll-behavior:smooth;
}

body{

  font-family:'Rajdhani',sans-serif;

  background:var(--bg-deep);
  color:var(--text);

  min-height:100vh;
  overflow-x:hidden;

  position:relative;
}

/* =========================================================
   FONDO CYBER
========================================================= */

.bg-grid{

  position:fixed;
  inset:0;

  z-index:-2;

  background-image:
    linear-gradient(rgba(58,169,255,.06) 1px,transparent 1px),
    linear-gradient(90deg,rgba(58,169,255,.06) 1px,transparent 1px);

  background-size:48px 48px;

  mask-image:
    radial-gradient(circle at center,#000 0%,transparent 75%);
}

.bg-glow{

  position:fixed;
  inset:0;

  z-index:-1;

  background:
    radial-gradient(circle at top left,
      rgba(58,169,255,.25),
      transparent 35%
    ),

    radial-gradient(circle at top right,
      rgba(109,74,214,.18),
      transparent 35%
    ),

    radial-gradient(circle at bottom center,
      rgba(255,216,77,.08),
      transparent 45%
    );
}

/* =========================================================
   HEADER
========================================================= */

.site-header{

  max-width:1200px;

  margin:auto;

  display:flex;
  align-items:center;
  justify-content:space-between;

  padding:20px;

  flex-wrap:wrap;

  gap:12px;
}

.brand{

  display:flex;
  align-items:center;
  gap:14px;
}

.brand-shield{

  width:52px;
  height:52px;

  border-radius:14px;

  display:grid;
  place-items:center;

  background:
    linear-gradient(
      145deg,
      #0d4d8c,
      #051838
    );

  border:1px solid var(--border);

  box-shadow:
    0 0 30px rgba(58,169,255,.22);
}

.brand-title{

  font-family:'Orbitron',sans-serif;
  font-weight:900;

  font-size:20px;

  letter-spacing:1px;
}

.brand-sub{

  font-family:'Orbitron',sans-serif;

  font-size:10px;

  letter-spacing:6px;

  color:var(--blue-light);

  margin-top:2px;
}

.privacy-pill{

  display:flex;
  align-items:center;
  gap:8px;

  padding:8px 16px;

  border-radius:999px;

  background:
    rgba(20,220,130,.08);

  border:
    1px solid rgba(20,220,130,.35);

  color:#4ee79a;

  font-size:12px;
  font-weight:700;

  letter-spacing:1px;
}

.pulse-dot{

  width:8px;
  height:8px;

  border-radius:50%;

  background:#4ee79a;

  animation:pulse 2s infinite;
}

@keyframes pulse{

  0%{
    box-shadow:0 0 0 0 rgba(78,231,154,.6);
  }

  70%{
    box-shadow:0 0 0 14px rgba(78,231,154,0);
  }

  100%{
    box-shadow:0 0 0 0 rgba(78,231,154,0);
  }
}

/* =========================================================
   HERO
========================================================= */

.hero{

  position:relative;

  overflow:hidden;

  min-height:560px;

  margin:20px auto;

  max-width:1200px;

  border-radius:28px;

  display:flex;
  align-items:center;
  justify-content:center;

  padding:40px 20px;

  background:

    radial-gradient(circle at top left,
      rgba(58,169,255,.22),
      transparent 35%
    ),

    radial-gradient(circle at bottom right,
      rgba(255,216,77,.10),
      transparent 35%
    ),

    linear-gradient(
      160deg,
      #081122 0%,
      #0d1430 50%,
      #111b3f 100%
    );

  border:1px solid rgba(127,211,255,.15);

  box-shadow:
    0 20px 80px rgba(0,0,0,.4);
}

.hero-content{

  position:relative;
  z-index:5;

  text-align:center;
}

.hero-tagline{

  font-family:'Orbitron',sans-serif;

  letter-spacing:6px;

  color:var(--blue-light);

  font-size:12px;

  margin-bottom:18px;
}

.hero-title{

  font-family:'Orbitron',sans-serif;

  font-size:clamp(60px,10vw,120px);

  font-weight:900;

  line-height:.9;

  text-shadow:
    0 0 40px rgba(58,169,255,.3);
}

.t-blue{

  background:
    linear-gradient(
      180deg,
      #7fd3ff 0%,
      #3aa9ff 50%,
      #0d4d8c 100%
    );

  -webkit-background-clip:text;
  -webkit-text-fill-color:transparent;
}

.t-yellow{

  background:
    linear-gradient(
      180deg,
      #ffe580 0%,
      #ffd84d 50%,
      #b8860b 100%
    );

  -webkit-background-clip:text;
  -webkit-text-fill-color:transparent;
}

.hero-subtitle{

  font-size:24px;

  font-weight:600;

  margin-top:20px;
}

.mission-tag{

  margin-top:18px;

  display:inline-block;

  padding:10px 22px;

  border-radius:999px;

  background:
    rgba(212,175,55,.08);

  border:
    1px solid rgba(212,175,55,.45);

  color:var(--gold-light);

  font-family:'Orbitron',sans-serif;

  font-size:12px;

  letter-spacing:2px;
}

/* =========================================================
   PERSONAJES
========================================================= */

.hero-characters{

  position:absolute;
  inset:0;

  pointer-events:none;
}

.hero-character{

  position:absolute;

  filter:
    drop-shadow(0 0 30px rgba(58,169,255,.25));

  animation:floatHero 4s ease-in-out infinite;
}

.cypher{

  width:240px;

  left:40px;
  bottom:20px;
}

.leo{

  width:220px;

  right:60px;
  bottom:10px;
}

.masker{

  width:180px;

  top:40px;
  right:40%;
}

@keyframes floatHero{

  0%{
    transform:translateY(0px);
  }

  50%{
    transform:translateY(-12px);
  }

  100%{
    transform:translateY(0px);
  }
}

/* =========================================================
   CONTAINER
========================================================= */

.container{

  max-width:1200px;

  margin:auto;

  padding:20px;

  display:flex;
  flex-direction:column;
  gap:26px;
}

/* =========================================================
   CARDS
========================================================= */

.form-card,
.cert-section,
.privacy-section,
.next-missions{

  position:relative;

  overflow:hidden;

  border-radius:24px;

  padding:30px;

  background:
    linear-gradient(
      160deg,
      rgba(13,20,48,.88),
      rgba(8,12,30,.94)
    );

  border:
    1px solid rgba(127,211,255,.12);

  backdrop-filter:blur(10px);

  box-shadow:
    0 0 0 1px rgba(58,169,255,.08),
    0 20px 60px rgba(0,0,0,.4),
    0 0 50px rgba(58,169,255,.06);
}

.form-card::before,
.cert-section::before{

  content:"";

  position:absolute;

  top:0;
  left:0;
  right:0;

  height:2px;

  background:
    linear-gradient(
      90deg,
      transparent,
      var(--blue),
      transparent
    );
}

/* =========================================================
   FORM HEADER
========================================================= */

.form-header{

  display:flex;
  align-items:center;

  gap:16px;

  margin-bottom:24px;
}

.step-num{

  font-family:'Orbitron',sans-serif;

  font-size:28px;
  font-weight:900;

  background:
    linear-gradient(
      180deg,
      var(--blue-light),
      var(--blue-dark)
    );

  -webkit-background-clip:text;
  -webkit-text-fill-color:transparent;
}

.form-header h2{

  font-family:'Orbitron',sans-serif;

  font-size:24px;

  letter-spacing:1px;
}

.form-help{

  color:var(--text-dim);

  margin-top:4px;
}

/* =========================================================
   INPUT
========================================================= */

.input-wrap{

  position:relative;

  margin-bottom:24px;
}

.input-wrap input{

  width:100%;

  padding:20px 70px 20px 22px;

  border-radius:14px;

  border:2px solid rgba(127,211,255,.12);

  background:
    linear-gradient(
      180deg,
      rgba(15,20,45,.95),
      rgba(5,8,22,.98)
    );

  color:var(--text);

  font-size:24px;
  font-weight:700;

  outline:none;

  transition:.25s;
}

.input-wrap input:focus{

  border-color:var(--blue);

  box-shadow:
    0 0 0 4px rgba(58,169,255,.12),
    0 0 30px rgba(58,169,255,.12);
}

.input-counter{

  position:absolute;

  top:50%;
  right:18px;

  transform:translateY(-50%);

  color:var(--text-dim);

  font-size:12px;

  font-family:'Orbitron',sans-serif;
}

/* =========================================================
   BUTTONS
========================================================= */

.actions{

  display:flex;
  flex-wrap:wrap;

  gap:12px;

  margin-bottom:24px;
}

.btn{

  position:relative;

  overflow:hidden;

  display:flex;
  align-items:center;
  gap:10px;

  padding:14px 24px;

  border:none;

  border-radius:12px;

  cursor:pointer;

  font-family:'Orbitron',sans-serif;

  font-size:13px;
  font-weight:700;

  letter-spacing:1px;

  transition:.25s;
}

.btn:hover{

  transform:translateY(-2px);
}

.btn::before{

  content:"";

  position:absolute;

  top:0;
  left:-120%;

  width:100%;
  height:100%;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(255,255,255,.22),
      transparent
    );

  transition:.6s;
}

.btn:hover::before{

  left:120%;
}

.btn-primary{

  background:
    linear-gradient(
      135deg,
      var(--blue),
      var(--blue-dark)
    );

  color:white;

  box-shadow:
    0 10px 30px rgba(58,169,255,.35);
}

.btn-secondary{

  background:
    linear-gradient(
      135deg,
      var(--gold),
      #8a6e1c
    );

  color:#1a1000;
}

.btn-ghost{

  background:transparent;

  border:2px solid rgba(127,211,255,.12);

  color:white;
}

/* =========================================================
   CERTIFICATE
========================================================= */

.cert-stage{

  overflow-x:auto;

  border-radius:18px;

  padding:16px;

  background:
    rgba(0,0,0,.35);
}

.certificate{

  width:1000px;
  height:720px;

  margin:auto;

  position:relative;

  overflow:hidden;

  border-radius:12px;

  padding:50px 60px;

  background:

    linear-gradient(
      rgba(255,255,255,.94),
      rgba(255,255,255,.94)
    ),

    url("assets/img/certificate-bg.png");

  background-size:cover;
  background-position:center;

  box-shadow:
    0 30px 80px rgba(0,0,0,.45),
    0 0 0 8px rgba(13,77,140,.85),
    0 0 0 9px var(--gold);

  color:#0a1840;
}

.certificate-overlay{

  position:absolute;
  inset:0;

  background:

    radial-gradient(circle at top left,
      rgba(58,169,255,.10),
      transparent 30%
    ),

    radial-gradient(circle at bottom right,
      rgba(255,216,77,.08),
      transparent 30%
    );
}

.cert-character{

  position:absolute;

  z-index:2;
}

.cert-cypher{

  width:120px;

  left:40px;
  bottom:80px;
}

.cert-leo{

  width:110px;

  right:40px;
  bottom:80px;
}

.cert-masker{

  width:90px;

  top:120px;
  right:60px;

  opacity:.18;
}

.cert-title{

  text-align:center;

  font-family:'Orbitron',sans-serif;

  font-size:58px;

  font-weight:900;

  letter-spacing:6px;
}

.cert-name{

  text-align:center;

  margin-top:24px;

  font-family:'Orbitron',sans-serif;

  font-size:44px;

  text-transform:uppercase;

  text-shadow:
    0 2px 0 rgba(255,255,255,.8),
    0 4px 12px rgba(58,169,255,.18);
}

/* =========================================================
   MISSIONS
========================================================= */

.missions-grid{

  display:grid;

  grid-template-columns:
    repeat(auto-fit,minmax(220px,1fr));

  gap:16px;
}

.mission-card{

  padding:20px;

  border-radius:16px;

  background:
    linear-gradient(
      160deg,
      rgba(58,169,255,.08),
      rgba(109,74,214,.05)
    );

  border:
    1px solid rgba(127,211,255,.12);

  transition:.25s;
}

.mission-card:hover{

  transform:translateY(-4px);

  border-color:var(--blue);
}

/* =========================================================
   FOOTER
========================================================= */

.site-footer{

  text-align:center;

  padding:40px 20px;

  color:var(--text-dim);

  margin-top:40px;

  border-top:
    1px solid rgba(127,211,255,.08);
}

/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width:900px){

  .hero{

    min-height:720px;
  }

  .hero-character{

    opacity:.28;
  }

  .cypher{

    width:160px;

    left:-10px;
  }

  .leo{

    width:160px;

    right:-10px;
  }

  .masker{

    width:120px;

    top:60px;
    right:20px;
  }

  .certificate{

    transform:scale(.6);

    transform-origin:top left;
  }

  .actions{

    flex-direction:column;
  }

  .btn{

    width:100%;
    justify-content:center;
  }
}
