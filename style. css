}

/* ============== CONTAINER ============== */
.container {
  max-width: 1100px;
  margin: 28px auto;
  padding: 0 20px;
  display: flex; flex-direction: column; gap: 26px;
}

/* ============== FORM CARD ============== */
.form-card, .cert-section, .privacy-section, .next-missions {
  background: linear-gradient(160deg, rgba(13, 20, 48, 0.85), rgba(8, 12, 30, 0.92));
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 28px;
  backdrop-filter: blur(8px);
  position: relative;
  overflow: hidden;
}
.form-card::before, .cert-section::before {
  content: \"\"; position: absolute; top: 0; left: 0; right: 0; height: 2px;
  background: linear-gradient(90deg, transparent, var(--blue), transparent);
}
.form-header {
  display: flex; align-items: center; gap: 16px; margin-bottom: 20px;
}
.step-num {
  font-family: 'Orbitron', sans-serif;
  font-weight: 900;
  font-size: 26px;
  background: linear-gradient(180deg, var(--blue-light), var(--blue-dark));
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent;
  min-width: 48px;
}
.form-header h2 {
  font-family: 'Orbitron', sans-serif;
  font-size: clamp(18px, 2.5vw, 24px);
  font-weight: 700;
  letter-spacing: 1px;
}
.form-help { color: var(--text-dim); font-size: 14px; margin-top: 2px; }

.input-wrap { position: relative; margin-bottom: 22px; }
.input-wrap input {
  width: 100%;
  padding: 18px 70px 18px 22px;
  font-family: 'Rajdhani', sans-serif;
  font-size: 22px;
  font-weight: 600;
  color: var(--text);
  background: rgba(5, 8, 22, 0.8);
  border: 2px solid var(--border);
  border-radius: 12px;
  outline: none;
  transition: border-color 0.2s, box-shadow 0.2s;
  letter-spacing: 1px;
}
.input-wrap input::placeholder { color: rgba(154, 168, 212, 0.5); font-weight: 400; }
.input-wrap input:focus {
  border-color: var(--blue);
  box-shadow: 0 0 0 4px rgba(58, 169, 255, 0.15), var(--shadow-glow);
}
.input-counter {
  position: absolute; right: 18px; top: 50%; transform: translateY(-50%);
  font-size: 12px; color: var(--text-dim);
  font-family: 'Orbitron', sans-serif;
}

/* ACTIONS */
.actions { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 22px; }
.btn {
  display: inline-flex; align-items: center; gap: 10px;
  padding: 14px 22px;
  font-family: 'Orbitron', sans-serif;
  font-weight: 700;
  font-size: 13px;
  letter-spacing: 1.5px;
  border: none; border-radius: 10px;
  cursor: pointer;
  transition: transform 0.15s, box-shadow 0.2s, background 0.2s;
  text-transform: uppercase;
}
.btn:active { transform: translateY(1px); }
.btn-primary {
  background: linear-gradient(135deg, var(--blue) 0%, var(--blue-dark) 100%);
  color: white;
  box-shadow: 0 6px 20px rgba(58, 169, 255, 0.35);
}
.btn-primary:hover { box-shadow: 0 8px 28px rgba(58, 169, 255, 0.5); transform: translateY(-2px); }
.btn-secondary {
  background: linear-gradient(135deg, var(--gold) 0%, #8a6e1c 100%);
  color: #1a1000;
  box-shadow: 0 6px 20px rgba(212, 175, 55, 0.3);
}
.btn-secondary:hover { box-shadow: 0 8px 28px rgba(212, 175, 55, 0.5); transform: translateY(-2px); }
.btn-ghost {
  background: transparent;
  border: 2px solid var(--border);
  color: var(--text);
}
.btn-ghost:hover { border-color: var(--blue); background: rgba(58, 169, 255, 0.08); }
.btn:disabled { opacity: 0.4; cursor: not-allowed; transform: none !important; }

/* TRUST */
.trust-row { display: flex; flex-wrap: wrap; gap: 18px; padding-top: 18px; border-top: 1px solid var(--border); }
.trust-item { display: flex; gap: 12px; align-items: center; flex: 1; min-width: 220px; }
.trust-icon { font-size: 24px; }
.trust-item strong { display: block; font-size: 14px; }
.trust-item small { display: block; color: var(--text-dim); font-size: 12px; }

/* ============================================================
   CERTIFICADO  — diseño en HTML/CSS, español
   ============================================================ */
.cert-stage {
  background: rgba(0,0,0,0.35);
  border-radius: 14px;
